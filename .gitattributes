# Нормализация переводов строк.
#
# В репозитории все текстовые файлы хранятся с LF — так одинаково
# выглядит история изменений на Windows, macOS и в CI.
* text=auto eol=lf

# Двоичные файлы: git не должен ни менять в них переводы строк,
# ни пытаться показывать различия построчно.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary
*.mobileprovision binary
*.ipa binary
*.aab binary
*.apk binary
*.zip binary

# Сгенерированные файлы, которые не нужно объединять при конфликтах.
pubspec.lock linguist-generated=true
*.freezed.dart linguist-generated=true
*.g.dart linguist-generated=true

# Языки для статистики GitHub.
*.dart linguist-language=Dart
*.kt linguist-language=Kotlin
*.swift linguist-language=Swift
